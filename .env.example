# Environment Configuration Template for AdaptiveLearn AI

# Application Environment
APP_ENV=development
DEBUG=true

# Security & Session Secrets (Must change in production)
SECRET_KEY=adaptivelearn-super-secret-key-change-in-production-1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database Connection
# Local SQLite: sqlite:///./adaptivelearn.db
# Azure Database for PostgreSQL: postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/adaptivelearn?sslmode=require
DATABASE_URL=sqlite:///./adaptivelearn.db

# CORS & Frontend Origins (Comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://adaptivelearn.vercel.app

# Generative AI Configuration (Google Gemini)
# Set to 'gemini' to enable personalized question synthesis for student learning gaps
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
